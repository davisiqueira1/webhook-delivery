# ---------------------------------------------------------------------------
# Node / NestJS
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ---------------------------------------------------------------------------
# Environment and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
.aws/
credentials

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan output can contain secrets in plain text
*.tfplan
tfplan
plan.out

crash.log
crash.*.log

# Variable files often hold credentials; commit the example instead
*.tfvars
*.tfvars.json
!*.tfvars.example

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
# It pins provider versions and must be committed.

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Lambda test receiver build artifacts
# ---------------------------------------------------------------------------
tools/**/*.zip
tools/**/.build/

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store
